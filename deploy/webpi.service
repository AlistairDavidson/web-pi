# web-pi systemd unit — adjust User/paths to your box.
# Install:  cp webpi.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now webpi
#
# Hardening notes (tested against node-pty + tmux on Debian 13):
#  - Do NOT set PrivateTmp: the tmux socket lives in the REAL
#    /tmp/tmux-<uid>/ and a private tmp namespace hides it from node-pty.
#  - Do NOT set MemoryDenyWriteExecute: V8's JIT needs W^X pages.
#  - ProtectHome=read-only is fine when the server only READS sessions
#    and pi files: pi processes are spawned by the tmux *server*, not by
#    this unit, so they're unaffected by this unit's sandbox. If you spawn
#    pi directly from the server, relax accordingly.

[Unit]
Description=web-pi (pi sessions in the browser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webpi
Group=webpi
WorkingDirectory=/srv/web-pi
Environment=NODE_ENV=production
Environment=WEB_PI_HOST=127.0.0.1
Environment=WEB_PI_PORT=3000
# For a subpath deploy set this BEFORE the build too (it is baked into pages):
#Environment=WEB_PI_BASE=/console
# Point at your pi/session layout if it differs from the default:
#Environment=WEB_PI_HOME=/home/webpi
#Environment=WEB_PI_AGENT_DIR=/srv/web-pi/.pi-agent
ExecStart=/usr/bin/node dist-server/server/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
# The server seeds the runtime pi agent dir at boot (template → runtime):
ReadWritePaths=/srv/web-pi/.pi-agent
ProtectHome=read-only
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
