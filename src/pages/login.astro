---
import Base from '../layouts/Base.astro';
// Frontmatter imports SSR these components (astro-lit, declarative shadow
// DOM). They do NOT register client-side — the <script> below re-imports
// them so the browser upgrades + hydrates them (form submission, value,
// password toggle all need the live elements).
import '@awesome.me/webawesome/dist/components/card/card.js';
import '@awesome.me/webawesome/dist/components/input/input.js';
import '@awesome.me/webawesome/dist/components/button/button.js';
import '@awesome.me/webawesome/dist/components/callout/callout.js';
import '@awesome.me/webawesome/dist/components/icon/icon.js';
---
<Base title="web-pi — sign in">
  <main class="login-main wa-stack">
    <wa-card class="login-card">
      <h1><wa-icon name="terminal"></wa-icon> web-pi</h1>
      <form id="login-form" class="wa-stack wa-gap-m">
        <wa-input id="username" label="username" autocomplete="username" autofocus></wa-input>
        <wa-input
          id="password"
          label="password"
          type="password"
          password-toggle
          autocomplete="current-password"
        ></wa-input>
        <wa-button type="submit" variant="brand">sign in</wa-button>
        <wa-callout id="error" variant="danger" class="hidden"></wa-callout>
      </form>
    </wa-card>
  </main>
</Base>

<script>
  // Support modules MUST precede the wa-* imports — if the SSR'd elements
  // define before lit hydration support installs, they render twice
  // (@awesome.me/astro-lit README). Not script-position-dependent.
  import '@awesome.me/astro-lit/dsd-polyfill.js';
  import '@awesome.me/astro-lit/hydration-support.js';
  // Client-side: define the SSR'd wa-* components (upgrade + hydrate).
  import '@awesome.me/webawesome/dist/components/card/card.js';
  import '@awesome.me/webawesome/dist/components/input/input.js';
  import '@awesome.me/webawesome/dist/components/button/button.js';
  import '@awesome.me/webawesome/dist/components/callout/callout.js';
  import '@awesome.me/webawesome/dist/components/icon/icon.js';

  import { BASE } from '../base';
  const value = (id: string): string =>
    (document.getElementById(id) as unknown as { value: string }).value;
  document.getElementById('login-form')!.addEventListener('submit', async e => {
    e.preventDefault();
    const err = document.getElementById('error')!;
    err.classList.add('hidden');
    const res = await fetch(`${BASE}/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: value('username'), password: value('password') }),
    });
    if (res.ok) { location.href = `${BASE}/`; return; }
    err.textContent = res.status === 429 ? 'too many attempts — wait 15 minutes' : 'invalid credentials';
    err.classList.remove('hidden');
  });
</script>
