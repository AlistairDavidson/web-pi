---
import "@awesome.me/webawesome/dist/styles/webawesome.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="wa-theme-default wa-palette-default wa-brand-blue wa-dark"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <slot />
  </body>
</html>
<!-- No hydration script here: @awesome.me/astro-lit's support modules
     must run BEFORE component modules define, and a layout-level script
     has no execution-order guarantee vs page/component scripts. Each
     client <script> that imports wa-* components imports them itself
     (login.astro, ConsoleApp.astro, AgentTerminal.astro). -->

<style is:global>
  @import "../styles/console.css";
</style>
