---
// WaTextareaField.astro — WaInputField's twin for <wa-textarea>: the
// validation message lives in the hint slot (see WaInputField.astro for
// why). Client side, the page must still import the wa-textarea module.
import '@awesome.me/webawesome/dist/components/textarea/textarea.js';

interface Props {
  name: string;
  id?: string;
  label: string;
  hint?: string;
  error?: string | undefined;
  [key: string]: unknown;
}

const { name, id = name, label, hint, error, ...attrs } = Astro.props;
const errorId = `${id}-error`;
---
<wa-textarea id={id} name={name} label={label} aria-errormessage={errorId} with-hint {...attrs}>
  <div slot="hint" class="field-hint">
    {hint && <span class="field-hint-text">{hint}</span>}
    <span id={errorId} class="field-error">{error}</span>
  </div>
</wa-textarea>
