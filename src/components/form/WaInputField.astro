---
// WaInputField.astro — a <wa-input> whose validation message lives in its
// hint slot (the soothing-booking SbInput idea, on Web Awesome;
// docs/CODE_STYLE.md §8). Why the hint slot: the real <input> is inside
// the wa-input's shadow DOM, so aria-errormessage / aria-invalid on the
// host never reach it — but its aria-describedby points at the hint slot,
// so a message slotted there is announced with the field.
// validation-enhancer(-zod) finds the message element through
// aria-errormessage (an id lookup inside the enhancer) and writes into it;
// `error` pre-fills it (a server-rendered failure).
// Client side, the page must still import the wa-input module (AGENTS.md:
// SSR imports ≠ client imports).
import '@awesome.me/webawesome/dist/components/input/input.js';

interface Props {
  name: string;
  id?: string;
  label: string;
  hint?: string;
  error?: string | undefined;
  [key: string]: unknown;
}

const { name, id = name, label, hint, error, ...attrs } = Astro.props;
const errorId = `${id}-error`;
---
<wa-input id={id} name={name} label={label} aria-errormessage={errorId} with-hint {...attrs}>
  <div slot="hint" class="field-hint">
    {hint && <span class="field-hint-text">{hint}</span>}
    <span id={errorId} class="field-error">{error}</span>
  </div>
</wa-input>
